# =============================================================================
# 飞书知识库博客配置
# =============================================================================
# 配置说明：
# 1. 先在飞书开放平台创建企业自建应用
# 2. 在飞书中创建知识库，并获取 Token
# 3. 在知识库中创建「博客」文件夹，存放博客文章
# 4. 将以下配置填入 .env 文件
# =============================================================================

# -----------------------------------------------------------------------------
# 飞书开放平台应用配置
# 获取地址：https://open.feishu.cn/app
# -----------------------------------------------------------------------------

# 应用 ID（创建应用后获得）
VITE_FEISHU_APP_ID=cli_xxxxxxxxxxxx

# 应用 Secret（创建应用后获得）
# ⚠️ 注意：生产环境应通过后端代理，不要在前端直接暴露此密钥

# -----------------------------------------------------------------------------
# 飞书知识库配置
# -----------------------------------------------------------------------------

# 知识库 Token（从知识库 URL 获取）
# 例如：https://xxx.feishu.cn/wiki/XXXXXX 中的 XXXXXX
VITE_FEISHU_WIKI_TOKEN=xxxxxxxxxxxx

# 博客文件夹 Token（可选，用于指定博客存放的文件夹）
# 如果不设置，将获取知识库根目录下的所有文档
# 获取方式：在飞书知识库中右键点击文件夹 -> 复制链接 -> 提取 node_token 参数
VITE_FEISHU_BLOG_FOLDER_TOKEN=xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 数据源配置
# -----------------------------------------------------------------------------

# 数据源模式
# - feishu: 仅使用飞书知识库数据源（需要正确配置飞书参数）
# - static: 仅使用静态数据（无需后端服务，适合纯静态部署）
# - auto: 优先飞书，失败时降级到静态数据（默认，推荐）
VITE_DATA_SOURCE_MODE=auto

# -----------------------------------------------------------------------------
# 缓存配置
# -----------------------------------------------------------------------------

# 缓存时长（分钟，默认 10）
# 飞书 API 有调用频率限制，建议开启缓存
VITE_CACHE_DURATION=10

# -----------------------------------------------------------------------------
# 后端代理配置（可选）
# -----------------------------------------------------------------------------

# 后端代理服务器地址
# 如果使用后端代理处理飞书 API 请求，请设置此项
# 例如：http://localhost:3001 或 https://your-api-server.com
# VITE_API_BASE_URL=http://localhost:3001

# 开发期 Vite 代理目标（vite.config.ts 读取，不带 VITE_ 前缀限制）
# 仅影响 npm run dev 时 /api/feishu 的转发目标，不打包进产物。
# 默认 http://localhost:3001；若本机 3001 已被其他项目占用，
# 在此改端口，并同步修改 server/.env 的 PORT，二者必须一致。
# VITE_PROXY_TARGET=http://localhost:3001

# 开发服务器监听地址（vite.config.ts 读取，不打包进产物）
# 默认 localhost 仅本机可访问。设为 0.0.0.0 可让局域网设备通过本机 IP 访问，
# 便于在手机上验证效果——但同网段的其他人也能访问，公共网络下慎用。
# VITE_DEV_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 阅读量计数（可选）
# -----------------------------------------------------------------------------

# analytics/ 那个 Cloudflare Worker 的地址，例如 https://personalweb-views.xxx.workers.dev
# 不配置则前端完全不发上报请求——不是发了再吞错误，是一个请求都不发。
# 这里放的只是一个公开端点地址，不是密钥，因此可以带 VITE_ 前缀。
# 读取统计要用的 STATS_TOKEN 存在 Worker 的 secret 里，绝不能出现在本文件或任何 app/ 下的 env。
# 阅读量只给站主看，页面不展示，详见 analytics/CLAUDE.md。
# VITE_VIEW_COUNTER_URL=https://personalweb-views.your-subdomain.workers.dev
